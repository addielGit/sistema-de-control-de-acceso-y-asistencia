# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/accessflow?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-here"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_NAME="AccessFlow"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Work schedule defaults
DEFAULT_CHECKIN_TIME="09:00"
DEFAULT_CHECKOUT_TIME="18:00"
LATE_TOLERANCE_MINUTES="15"

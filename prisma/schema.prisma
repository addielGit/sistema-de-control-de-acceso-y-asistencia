generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
}

enum AccessAction {
  ENTRY
  EXIT
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String
  password      String
  role          Role         @default(EMPLOYEE)
  department    String?
  position      String?
  phone         String?
  avatar        String?
  qrCode        String?      @unique
  isActive      Boolean      @default(true)
  dashboardLayout Json?        // Stores widget order/position for admin dashboard
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  attendances   Attendance[]
  accessLogs    AccessLog[]
  auditLogs     AuditLog[]   @relation("AuditUser")
  actorLogs     AuditLog[]   @relation("AuditActor")

  @@map("users")
}

model Attendance {
  id          String           @id @default(cuid())
  userId      String
  date        DateTime         @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  status      AttendanceStatus @default(PRESENT)
  lateMinutes Int              @default(0)
  notes       String?
  source      String           @default("USER")  // "USER" | "ADMIN" | "EDIT"
  markedBy    String?          // admin name when source = "ADMIN"
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("attendances")
}

model AccessLog {
  id        String       @id @default(cuid())
  userId    String
  action    AccessAction
  timestamp DateTime     @default(now())
  method    String       @default("MANUAL")
  ipAddress String?
  device    String?
  location  String?

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("access_logs")
}

model WorkSchedule {
  id           String   @id @default(cuid())
  name         String
  checkInTime  String
  checkOutTime String
  lateTolerance Int     @default(15)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("work_schedules")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  actorId   String
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation("AuditUser", fields: [userId], references: [id])
  actor     User     @relation("AuditActor", fields: [actorId], references: [id])

  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model WorkConfig {
  id                  String   @id @default(cuid())
  // Días laborales (0=Dom, 1=Lun, ... 6=Sáb)
  workDays            Int[]    @default([1, 2, 3, 4, 5])
  // Tolerancia en minutos para entrada y salida
  checkInTolerance    Int      @default(10)
  checkOutTolerance   Int      @default(10)
  // Horario base
  checkInTime         String   @default("09:00")
  checkOutTime        String   @default("18:00")
  // Días festivos (fechas en formato "YYYY-MM-DD")
  holidays            String[] @default([])
  updatedAt           DateTime @updatedAt
  updatedBy           String?

  @@map("work_config")
}
